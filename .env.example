# Skopiuj do .env i uzupełnij. Plik .env jest w .gitignore - nie commituj kluczy.

# Wymagane: klucz Anthropic API (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=dev-alice-123

# Opcjonalne: połączenie przez AI Gateway (proxy) zamiast bezpośrednio z Anthropic.
# Wtedy ANTHROPIC_API_KEY to klucz gateway (z GATEWAY_KEYS proxy), nie prawdziwy klucz Anthropic.
ANTHROPIC_BASE_URL=http://127.0.0.1:8088

# Opcjonalne (poniżej wartości domyślne)
CLAUDE_MODEL=claude-haiku-4-5-20251001
ZEEBE_ADDRESS=localhost:26500
OUTPUT_DIR=output
